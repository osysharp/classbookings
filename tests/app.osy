// The producer's test project for Osysharp.ClassBookings — a cookery school: classes in its kitchens with its chefs, a weekly
// course, parents booking their children into the kids' classes (Osysharp.Guardianship), and walk-ins at the door made
// as accounts nobody signs in to (Osysharp.UserAccounts). Run it from the repository: `osy test kits/class-bookings/tests`.
app ClassBookingsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Guardianship@0;
  use Osysharp.ClassBookings@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  use Osysharp.Oauth;
}
