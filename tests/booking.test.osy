// Booking: numbered places given lowest first, never more than the session has — kept by the application and, under
// it, by the data itself.
using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.ClassBookings;

[Test(School)]
void places_are_given_lowest_first_and_the_next_person_waits_when_full() {
  runas (Ana) {
    var got = BookSession(Cls("Pasta"), Ana);
    Assert.Equal(BookingResult.Booked, got.Result);
    Assert.Equal(1, got.Booking!.Seat);
    Assert.Equal(1, PlacesLeft(Cls("Pasta")));
  }
  runas (Ben) { Assert.Equal(2, BookSession(Cls("Pasta"), Ben).Booking!.Seat); }
  runas (Cy) {
    var got = BookSession(Cls("Pasta"), Cy);
    Assert.Equal(BookingResult.Waitlisted, got.Result);
    Assert.Null(got.Booking!.Seat);
    Assert.Equal(1, QueuePosition(got.Booking!));
    Assert.Contains("waiting list", got.Message);
    Assert.Equal(0, PlacesLeft(Cls("Pasta")));
  }
  Assert.Equal(2, HeardCount("confirmed"));
  Assert.Equal(1, HeardCount("waitlist"));
}

[Test(School)]
void booking_twice_is_answered_and_changes_nothing() {
  runas (Ana) {
    BookSession(Cls("Pasta"), Ana);
    var again = BookSession(Cls("Pasta"), Ana);
    Assert.Equal(BookingResult.AlreadyBooked, again.Result);
    Assert.Equal(1, Booking.Count(b => b.Session.Id == Cls("Pasta").Id));
  }
  Assert.Equal(1, HeardCount("confirmed"));
}

[Test(School)]
void a_freed_place_with_nobody_waiting_is_free_again_and_its_number_is_reused() {
  runas (Ana) { BookSession(Cls("Pasta"), Ana); }
  runas (Ben) { BookSession(Cls("Pasta"), Ben); }
  runas (Ana) {
    Assert.Equal(BookingResult.Cancelled, CancelBooking(Mine("Pasta", Ana)).Result);
    Assert.Equal(1, PlacesLeft(Cls("Pasta")));
  }
  runas (Cy) { Assert.Equal(1, BookSession(Cls("Pasta"), Cy).Booking!.Seat); }
  Assert.Equal(0, HeardCount("offered"));
}

[Test(School)]
void a_person_who_cancelled_books_again_on_the_same_row() {
  runas (Ana) {
    var first = BookSession(Cls("Sushi"), Ana).Booking!;
    CancelBooking(first);
    var again = BookSession(Cls("Sushi"), Ana);
    Assert.Equal(BookingResult.Booked, again.Result);
    Assert.Equal(first.Id, again.Booking!.Id);
  }
}

[Test(School)]
void a_full_session_without_a_waiting_list_refuses() {
  runas (Ana) { Assert.Equal(BookingResult.Booked, BookSession(Cls("Supper club"), Ana).Result); }
  runas (Ben) {
    var got = BookSession(Cls("Supper club"), Ben);
    Assert.Equal(BookingResult.Refused, got.Result);
    Assert.Contains("no waiting list", got.Message);
  }
}

[Test(School)]
void a_cancelled_and_a_past_session_cannot_be_booked() {
  runas (Ana) {
    Assert.Equal(BookingResult.SessionCancelled, BookSession(Cls("Closed down"), Ana).Result);
    Assert.Equal(BookingResult.Closed, BookSession(Cls("Yesterday"), Ana).Result);
    Assert.Equal(0, Booking.Count());
  }
}

[Test(School)]
void the_schools_own_rule_refuses_a_class_that_needs_a_certificate_and_lets_a_certified_cook_in() {
  runas (Ana) {
    var got = BookSession(Cls("Knife skills"), Ana);
    Assert.Equal(BookingResult.Refused, got.Result);
    Assert.Equal("This class needs the knife-skills certificate first.", got.Message);
  }
  runas (Omar) { new KnifeCertificate { Person = Ana }; UnitOfWork.Commit(); }
  runas (Ana) { Assert.Equal(BookingResult.Booked, BookSession(Cls("Knife skills"), Ana).Result); }
}

// ── the data keeps it too ─────────────────────────────────────────────────────────────────────────────────────────

/// The school, and rows written past security — so what refuses the rest is the DATA itself.
[TestFixture]
void CrowdedByTheData() {
  var w = SeedSchool();
  var pasta = new CookingClass { Title = "Crowded", StartsAt = DateTime.UtcNow.AddDays(2), Capacity = 2 };
  new Booking { Session = pasta, Person = w.Ana, State = BookingState.Booked, Seat = 1 };
  UnitOfWork.Commit();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Ben, State = BookingState.Booked, Seat = 1 }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Ana, State = BookingState.Booked, Seat = 2 }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Cy, State = BookingState.Booked, Seat = 3 }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Cy, State = BookingState.Booked }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Cy, State = BookingState.Waiting, Seat = 2 }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
  new Booking { Session = pasta, Person = w.Ben, State = BookingState.Waiting, Ticket = 1 };
  UnitOfWork.Commit();
  Assert.Throws(() => { new Booking { Session = pasta, Person = w.Cy, State = BookingState.Waiting, Ticket = 1 }; UnitOfWork.Commit(); });
  UnitOfWork.Discard();
}

[Test(CrowdedByTheData)]
void the_data_alone_keeps_a_session_within_its_places() {
  runas (Omar) {
    Assert.Equal(1, Booking.Count(b => b.Session.Id == Cls("Crowded").Id && b.State == BookingState.Booked));
    Assert.Equal(1, PlacesLeft(Cls("Crowded")));
  }
}

[Test(School)]
void nobody_writes_a_booking_by_hand_whoever_they_are() {
  runas (Ana) {
    Assert.Denied(() => { WriteBooking(Cls("Pasta"), Ana, 1); UnitOfWork.Commit(); });
    var mine = BookSession(Cls("Pasta"), Ana).Booking!;
    Assert.Denied(() => { SetState(mine, BookingState.Cancelled); UnitOfWork.Commit(); });
    Assert.Denied(() => { SetSeat(mine, 2); UnitOfWork.Commit(); });
    Assert.Denied(() => { mine.Delete(); UnitOfWork.Commit(); });
  }
  runas (Omar) {
    Assert.Denied(() => { SetState(Mine("Pasta", Ana), BookingState.Attended); UnitOfWork.Commit(); });   // the desk goes through the functions too
    Assert.Denied(() => { WriteBooking(Cls("Pasta"), Omar, 2); UnitOfWork.Commit(); });
  }
}

[Test(School)]
void a_sessions_places_times_and_cancellation_change_only_through_the_kit() {
  runas (Omar) {
    Assert.Denied(() => { SetCapacityDirectly(Cls("Pasta"), 20); UnitOfWork.Commit(); });
    Assert.Denied(() => { SetStartDirectly(Cls("Pasta"), DateTime.UtcNow.AddDays(9)); UnitOfWork.Commit(); });
    var pasta = Cls("Pasta");
    pasta.Cuisine = "Sicilian";                      // the school's own fields are the school's to edit
    UnitOfWork.Commit();
    Assert.Equal("Sicilian", Cls("Pasta").Cuisine);
  }
  runas (Ana) {
    Assert.Denied(() => { Cls("Pasta").Title = "Mine"; UnitOfWork.Commit(); });
    Assert.Throws<NotAuthorized>(() => CancelSession(Cls("Pasta")));
  }
}

[Test(School)]
void more_places_go_to_the_people_waiting_and_fewer_never_strand_a_holder() {
  runas (Ana) { BookSession(Cls("Sushi"), Ana); }
  runas (Ben) { BookSession(Cls("Sushi"), Ben); }
  runas (Omar) {
    SetCapacity(Cls("Sushi"), 2);
    Assert.Equal(BookingState.Offered, Mine("Sushi", Ben).State);
    Assert.Contains("cannot go below", Assert.Throws(() => SetCapacity(Cls("Sushi"), 1)).Message);
  }
  Assert.Equal(1, HeardCount("offered"));
}

[Test(School)]
void cancelling_a_session_cancels_every_booking_and_nothing_is_late() {
  runas (Ana) { BookSession(Cls("Sushi"), Ana); }
  runas (Ben) { BookSession(Cls("Sushi"), Ben); }
  runas (Omar) {
    Assert.Equal(2, CancelSession(Cls("Sushi")));
    Assert.Equal(0, CancelSession(Cls("Sushi")));
    Assert.Equal(0, Booking.Count(b => b.LateCancel));
  }
  Assert.Equal(2, HeardCount("cancelled"));
  Assert.Equal(1, HeardCount("session-cancelled"));
}

[Test(School)]
void forgetting_a_person_removes_their_bookings_and_passes_their_place_on() {
  runas (Ana) { BookSession(Cls("Sushi"), Ana); }
  runas (Ben) { BookSession(Cls("Sushi"), Ben); }
  runas (Ana) { Assert.Throws<NotAuthorized>(() => ForgetBookingsOf(Ben)); }
  runas (Omar) {
    Assert.Equal(1, ForgetBookingsOf(Ana));
    Assert.Equal(0, Booking.Count(b => b.Person.Id == Ana.Id));
    Assert.Equal(BookingState.Offered, Mine("Sushi", Ben).State);
  }
}
